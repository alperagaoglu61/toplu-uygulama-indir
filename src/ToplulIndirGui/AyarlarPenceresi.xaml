<Window x:Class="TopluIndir.Gui.AyarlarPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ayarlar" Height="404" Width="480"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        Background="{StaticResource PencereArka}"
        FontFamily="{StaticResource AnaYazi}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">

  <WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" CornerRadius="8" GlassFrameThickness="0"
                        ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource Kenarlik}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource BaslikArka}" Height="38"
              MouseLeftButtonDown="Baslik_Surukle">
        <Grid>
          <TextBlock Text="Ayarlar" Foreground="{StaticResource AnaMetin}" FontSize="13"
                     VerticalAlignment="Center" Margin="14,0,0,0" />
          <Button Style="{StaticResource KapatButon}" HorizontalAlignment="Right" Click="Kapat_Tik">
            <Path Data="{StaticResource ikon.kapat}" Fill="{StaticResource IkonPasif}"
                  Width="13" Height="13" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18,16,18,0">
        <TextBlock Text="Bir dosya için paralel bağlantı sayısı" Foreground="{StaticResource AnaMetin}"
                   FontSize="12.5" />
        <TextBlock Text="1-64 arası. Yüksek değer yavaş sunucularda fayda etmez."
                   Foreground="{StaticResource IkincilMetin}" FontSize="11" Margin="0,3,0,6" />
        <TextBox x:Name="txtParca" Style="{StaticResource AramaKutusu}" Width="90" HorizontalAlignment="Left" />

        <TextBlock Text="Aynı anda indirilecek program sayısı" Foreground="{StaticResource AnaMetin}"
                   FontSize="12.5" Margin="0,16,0,0" />
        <TextBlock Text="1-8 arası." Foreground="{StaticResource IkincilMetin}" FontSize="11" Margin="0,3,0,6" />
        <TextBox x:Name="txtEsZamanli" Style="{StaticResource AramaKutusu}" Width="90" HorizontalAlignment="Left" />

        <TextBlock Text="İndirme klasörü" Foreground="{StaticResource AnaMetin}"
                   FontSize="12.5" Margin="0,16,0,0" />
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="txtKlasor" Grid.Column="0" Style="{StaticResource AramaKutusu}" />
          <Button Grid.Column="1" Content="Gözat" Style="{StaticResource SadeButon}"
                  Margin="8,0,0,0" Click="Gozat_Tik" />
        </Grid>
      </StackPanel>

      <Border Grid.Row="2" Background="{StaticResource BaslikArka}" Padding="14,10"
              BorderBrush="{StaticResource Kenarlik}" BorderThickness="0,1,0,0">
        <Grid>
          <TextBlock Text="Bu ayarlar konsol scriptiyle ortaktır." VerticalAlignment="Center"
                     Foreground="{StaticResource IkincilMetin}" FontSize="11" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vazgeç" Style="{StaticResource SadeButon}" Click="Kapat_Tik" Margin="0,0,8,0" />
            <Button Content="Kaydet" Style="{StaticResource AnaButon}" Click="Kaydet_Tik" Padding="16,6" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
