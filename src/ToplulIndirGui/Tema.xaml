  <SolidColorBrush x:Key="IkonPasif"      Color="#8A8A86" />
  <SolidColorBrush x:Key="AnaMetin"       Color="#E7E7E5" />
  <SolidColorBrush x:Key="IkincilMetin"   Color="#7A7A77" />
  <SolidColorBrush x:Key="IlerlemeDolgu"  Color="#6A6E75" />
