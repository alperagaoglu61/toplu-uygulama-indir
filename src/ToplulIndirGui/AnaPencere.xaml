<Window x:Class="TopluIndir.Gui.AnaPencere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:donusturucu="clr-namespace:TopluIndir.Gui.Donusturucu"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Toplu Program İndir"
        Height="700" Width="1000" MinHeight="520" MinWidth="820"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource PencereArka}"
        FontFamily="{StaticResource AnaYazi}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

  <WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" CornerRadius="8" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <donusturucu:IkonGeometri x:Key="ikonGeo" />
    <donusturucu:IkonRenk x:Key="ikonRenk" />
    <donusturucu:KategoriIkonu x:Key="katIkon" />
    <donusturucu:BoolGorunur x:Key="boolGorunur" />
    <donusturucu:MetinVarGorunur x:Key="metinGorunur" />
    <donusturucu:YuzdeGenislik x:Key="yuzdeGenislik" />

    <!-- Kategori karti (Ekran 1) -->
    <DataTemplate x:Key="KategoriKarti">
      <Border Width="164" Height="132" Margin="10" CornerRadius="18"
              Background="{StaticResource KartArka}"
              BorderBrush="{StaticResource KartKenarlik}" BorderThickness="1"
              Cursor="Hand" MouseLeftButtonUp="Kart_Tik">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KartHover}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Path Data="{Binding IkonAnahtari, Converter={StaticResource katIkon}}"
                Fill="{StaticResource IkonAktif}" Stretch="Uniform"
                Width="32" Height="32" Margin="0,0,0,12" />
          <TextBlock Text="{Binding Etiket}" Foreground="{StaticResource AnaMetin}"
                     FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <TextBlock Text="{Binding Sayi}" Foreground="{StaticResource IkincilMetin}" FontSize="12" />
            <TextBlock Text=" program" Foreground="{StaticResource IkincilMetin}" FontSize="12" />
          </StackPanel>
          <Border Margin="0,6,0,0" CornerRadius="8" Padding="7,2"
                  Background="{StaticResource VurguDolgu}" HorizontalAlignment="Center"
                  Visibility="{Binding SecimVar, Converter={StaticResource boolGorunur}}">
            <TextBlock Foreground="{StaticResource VurguMetin}" FontSize="11">
              <Run Text="{Binding SeciliSayi, Mode=OneWay}" /><Run Text=" seçili" />
            </TextBlock>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Sol paneldeki kategori satiri (Ekran 2) -->
    <DataTemplate x:Key="KategoriSatiri">
      <Border x:Name="kb" Height="36" CornerRadius="6" Margin="6,2" Padding="8,0"
              Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Kategori_Tik">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path Grid.Column="0" Data="{Binding IkonAnahtari, Converter={StaticResource katIkon}}"
                Fill="{StaticResource IkonPasif}" Stretch="Uniform" Width="15" Height="15"
                VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Grid.Column="1" Text="{Binding Etiket}" VerticalAlignment="Center"
                     Foreground="#A3A3A0" FontSize="12.5" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding Sayi}" VerticalAlignment="Center"
                     Foreground="{StaticResource IkincilMetin}" FontSize="11" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Aktif}" Value="True">
          <Setter TargetName="kb" Property="Background" Value="{StaticResource KategoriAktif}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Program satiri -->
    <DataTemplate x:Key="ProgramSatiri">
      <Border x:Name="pb" Height="52" CornerRadius="6" Margin="4,1" Padding="10,0"
              Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Program_Tik">
        <Border.ContextMenu>
          <ContextMenu Background="#232428" Foreground="{StaticResource AnaMetin}"
                       BorderBrush="{StaticResource Kenarlik}" BorderThickness="1">
            <MenuItem Header="İndirme klasörünü aç" Click="KlasorAc_Tik" />
            <MenuItem Header="Linki kopyala" Click="LinkKopyala_Tik" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0" Style="{StaticResource ListeCheck}" VerticalAlignment="Center"
                    IsChecked="{Binding Secili, Mode=TwoWay}" IsHitTestVisible="False" />

          <Grid Grid.Column="1" Width="26" Height="26" Margin="12,0,12,0" VerticalAlignment="Center">
            <!-- Marka ikonu: kendi resmi renginde -->
            <Path Data="{Binding Ikon, Converter={StaticResource ikonGeo}}"
                  Fill="{Binding Ikon, Converter={StaticResource ikonRenk}}"
                  Stretch="Uniform"
                  Visibility="{Binding Ikon, Converter={StaticResource metinGorunur}}" />
            <!-- Marka ikonu yoksa harf kutucugu -->
            <Border CornerRadius="6" Background="#2E3035"
                    Visibility="{Binding Ikon, Converter={StaticResource metinGorunur}, ConverterParameter=ters}">
              <TextBlock Text="{Binding Harf}" Foreground="{StaticResource IkonAktif}"
                         FontSize="13" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Ad}" Foreground="{StaticResource AnaMetin}" FontSize="13" />
            <TextBlock Text="{Binding Aciklama}" Foreground="{StaticResource IkincilMetin}"
                       FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
          </StackPanel>

          <TextBlock Grid.Column="3" Text="{Binding BoyutMetni}" VerticalAlignment="Center"
                     Foreground="{StaticResource IkincilMetin}" FontSize="11.5" Margin="12,0,4,0" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="pb" Property="IsMouseOver" Value="True">
          <Setter TargetName="pb" Property="Background" Value="#212227" />
        </Trigger>
        <DataTrigger Binding="{Binding Secili}" Value="True">
          <Setter TargetName="pb" Property="Background" Value="{StaticResource SatirSecili}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Alt panel: aktif indirme satiri -->
    <DataTemplate x:Key="IndirmeSatirTemplate">
      <Border x:Name="ib" Height="38" CornerRadius="6" Margin="4,2" Padding="10,0" Background="#1F2024"
              ToolTip="{Binding Mesaj}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="{Binding Ad}" VerticalAlignment="Center"
                     Foreground="{StaticResource AnaMetin}" FontSize="12.5"
                     TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

          <Border x:Name="cubukArka" Grid.Column="1" Height="7" CornerRadius="4" Background="#2A2B30"
                  VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Border HorizontalAlignment="Left" CornerRadius="4"
                    Background="{StaticResource IlerlemeDolgu}">
              <Border.Width>
                <MultiBinding Converter="{StaticResource yuzdeGenislik}">
                  <Binding Path="Yuzde" />
                  <Binding Path="ActualWidth" ElementName="cubukArka" />
                </MultiBinding>
              </Border.Width>
            </Border>
          </Border>

          <TextBlock Grid.Column="2" Text="{Binding YuzdeMetni}" VerticalAlignment="Center"
                     HorizontalAlignment="Right" Foreground="{StaticResource IkincilMetin}" FontSize="11.5" />
          <TextBlock Grid.Column="3" Text="{Binding HizMetni}" VerticalAlignment="Center"
                     HorizontalAlignment="Right" Foreground="{StaticResource IkincilMetin}" FontSize="11.5" />
          <TextBlock Grid.Column="4" Text="{Binding DurumMetni}" VerticalAlignment="Center"
                     Margin="12,0,0,0" Foreground="{StaticResource IkonPasif}" FontSize="11.5" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HataVar}" Value="True">
          <Setter TargetName="ib" Property="Background" Value="{StaticResource HataArka}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Basarili}" Value="True">
          <Setter TargetName="ib" Property="Background" Value="#26282C" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border BorderBrush="{StaticResource Kenarlik}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />   <!-- baslik cubugu -->
        <RowDefinition Height="Auto" />   <!-- yarim indirme bildirimi -->
        <RowDefinition Height="*" />      <!-- ekran govdesi -->
        <RowDefinition Height="Auto" />   <!-- aktif indirmeler -->
        <RowDefinition Height="Auto" />   <!-- durum cubugu -->
      </Grid.RowDefinitions>

      <!-- ================= Baslik cubugu ================= -->
      <Border Grid.Row="0" Background="{StaticResource BaslikArka}" Height="38"
              MouseLeftButtonDown="Baslik_Surukle">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button x:Name="btnGeri" Style="{StaticResource SadeButon}" Click="Geri_Tik"
                    Visibility="Collapsed" Padding="7,3" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource ikon.geri}" Fill="{StaticResource IkonAktif}"
                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Kategoriler" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            <Ellipse Width="8" Height="8" Fill="{StaticResource IkonAktif}" VerticalAlignment="Center" />
            <TextBlock Text="Toplu Program İndir" Foreground="{StaticResource AnaMetin}"
                       FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="txtSayi" Foreground="{StaticResource IkincilMetin}"
                       FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource BaslikButon}" Click="Ayarlar_Tik" ToolTip="Ayarlar">
              <Path Data="{StaticResource ikon.ayar}" Fill="{StaticResource IkonPasif}"
                    Width="15" Height="15" Stretch="Uniform" />
            </Button>
            <Button Style="{StaticResource BaslikButon}" Click="Kucult_Tik">
              <Path Data="{StaticResource ikon.kucult}" Fill="{StaticResource IkonPasif}"
                    Width="13" Height="13" Stretch="Uniform" />
            </Button>
            <Button Style="{StaticResource BaslikButon}" Click="Buyut_Tik">
              <Path Data="{StaticResource ikon.buyut}" Fill="{StaticResource IkonPasif}"
                    Width="12" Height="12" Stretch="Uniform" />
            </Button>
            <Button Style="{StaticResource KapatButon}" Click="Kapat_Tik">
              <Path Data="{StaticResource ikon.kapat}" Fill="{StaticResource IkonPasif}"
                    Width="13" Height="13" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= Yarim indirme bildirimi ================= -->
      <Border x:Name="pnlYarim" Grid.Row="1" Background="#232428" Padding="14,8" Visibility="Collapsed"
              BorderBrush="{StaticResource Kenarlik}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock x:Name="txtYarim" Foreground="{StaticResource AnaMetin}" FontSize="12.5"
                     VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Devam et" Style="{StaticResource SadeButon}" Click="YarimDevam_Tik" Margin="0,0,8,0" />
            <Button Content="Yok say" Style="{StaticResource SadeButon}" Click="YarimYoksay_Tik" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= Govde ================= -->
      <Grid Grid.Row="2">

        <!-- EKRAN 1: kategori kartlari -->
        <Grid x:Name="ekranKategori">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,26,0,0" HorizontalAlignment="Center">
            <TextBlock Text="Bir kategori seç" Foreground="{StaticResource AnaMetin}"
                       FontSize="19" HorizontalAlignment="Center" />
            <Border Width="330" Margin="0,16,0,0" CornerRadius="7"
                    Background="#1F2024" BorderBrush="{StaticResource Kenarlik}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource ikon.ara}" Fill="{StaticResource IkonPasif}"
                      Width="14" Height="14" Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Grid Grid.Column="1">
                  <TextBox x:Name="txtAra1" Background="Transparent" BorderThickness="0"
                           Foreground="{StaticResource AnaMetin}" CaretBrush="{StaticResource AnaMetin}"
                           FontSize="13" Padding="8,7" TextChanged="Ara_Degisti" />
                  <TextBlock Text="Program ara..." Foreground="{StaticResource IkincilMetin}"
                             FontSize="13" Margin="9,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"
                             Visibility="{Binding Text, ElementName=txtAra1, Converter={StaticResource metinGorunur}, ConverterParameter=ters}" />
                </Grid>
              </Grid>
            </Border>
          </StackPanel>

          <!-- Kartlar -->
          <ItemsControl x:Name="listeKategoriKart" Grid.Row="1" Margin="24,22,24,20"
                        ItemsSource="{Binding}" ItemTemplate="{StaticResource KategoriKarti}"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel MaxWidth="760" HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <!-- Arama sonucu: kategori ayrimi kalkar, duz liste gorunur -->
          <Border x:Name="pnlArama1" Grid.Row="1" Margin="24,14,24,10" Visibility="Collapsed">
            <ListBox x:Name="listeArama1" Background="Transparent" BorderThickness="0"
                     ItemTemplate="{StaticResource ProgramSatiri}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </Border>
        </Grid>

        <!-- EKRAN 2: kategori icerigi -->
        <Grid x:Name="ekranListe" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="164" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Sol panel -->
          <Border Grid.Column="0" Background="#191A1D" BorderBrush="{StaticResource Kenarlik}"
                  BorderThickness="0,0,1,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Kategoriler" Margin="14,14,0,8"
                         Foreground="{StaticResource IkincilMetin}" FontSize="11"
                         FontWeight="SemiBold" />
              <ItemsControl x:Name="listeKategoriYan" ItemTemplate="{StaticResource KategoriSatiri}" />
            </DockPanel>
          </Border>

          <!-- Orta panel -->
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,12,14,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" CornerRadius="7" Background="#1F2024"
                      BorderBrush="{StaticResource Kenarlik}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Path Grid.Column="0" Data="{StaticResource ikon.ara}" Fill="{StaticResource IkonPasif}"
                        Width="14" Height="14" Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center" />
                  <Grid Grid.Column="1">
                    <TextBox x:Name="txtAra2" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource AnaMetin}" CaretBrush="{StaticResource AnaMetin}"
                             FontSize="13" Padding="8,6" TextChanged="Ara_Degisti" />
                    <TextBlock Text="Ara..." Foreground="{StaticResource IkincilMetin}" FontSize="13"
                               Margin="9,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"
                               Visibility="{Binding Text, ElementName=txtAra2, Converter={StaticResource metinGorunur}, ConverterParameter=ters}" />
                  </Grid>
                </Grid>
              </Border>

              <Button x:Name="btnTumunuSec" Grid.Column="1" Content="Tümünü seç"
                      Style="{StaticResource SadeButon}" Margin="10,0,0,0" Click="TumunuSec_Tik" />
            </Grid>

            <ListBox x:Name="listeProgram" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="10,0,10,10" ItemTemplate="{StaticResource ProgramSatiri}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </Grid>
        </Grid>
      </Grid>

      <!-- ================= Aktif indirmeler ================= -->
      <Border x:Name="pnlIndirme" Grid.Row="3" Background="#161719" Visibility="Collapsed"
              BorderBrush="{StaticResource Kenarlik}" BorderThickness="0,1,0,0" Padding="10,6">
        <ScrollViewer MaxHeight="152" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="listeIndirme" ItemTemplate="{StaticResource IndirmeSatirTemplate}" />
        </ScrollViewer>
      </Border>

      <!-- ================= Durum cubugu ================= -->
      <Border Grid.Row="4" Background="{StaticResource BaslikArka}" Padding="14,9"
              BorderBrush="{StaticResource Kenarlik}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="txtDurum" Grid.Column="0" VerticalAlignment="Center"
                     Foreground="{StaticResource IkincilMetin}" FontSize="12"
                     TextTrimming="CharacterEllipsis" Margin="0,0,14,0"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          <TextBlock x:Name="txtSecim" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"
                     Foreground="{StaticResource AnaMetin}" FontSize="12" />
          <Button x:Name="btnIndir" Grid.Column="2" Content="İndir" Style="{StaticResource AnaButon}"
                  Click="Indir_Tik" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
